{
  "name": "nova",
  "version": "0.1.0",
  "description": "AI provider SDK + MCP server scaffolding. Canonical contracts (chat, embeddings, models, stream, usage), OpenAI-compat adapter factory, and cross-cutting helpers for MCP servers. Monorepo housing @nova/contracts + @nova/mcp-shared + @nova/mcp.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "typecheck:strict": "tsc --noEmit -p tsconfig.eslint.json",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0 && npm run typecheck:strict",
    "lint:fix": "eslint . --fix",
    "test": "bun test packages/contracts/test packages/mcp-shared/test packages/mcp/test"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0"
  }
}
