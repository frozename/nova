{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/bin/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "scripts/**/*.ts",
    "eslint.config.mjs"
  ],
  "exclude": ["node_modules", "**/dist", "coverage"]
}
